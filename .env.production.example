# Copie para .env.production e substitua todos os valores de exemplo.
# APP_DOMAIN, rede, entrypoint e certresolver devem coincidir com o Traefik instalado.
APP_DOMAIN=agroclaw.example.com
TRAEFIK_NETWORK=traefik-public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
GHCR_OWNER=rubens-create
IMAGE_TAG=latest

POSTGRES_DB=agroclaw
POSTGRES_USER=agroclaw
# Use uma senha aleatória longa, apenas com letras e números, e repita-a na DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_PASSWORD
DATABASE_URL=postgresql://agroclaw:REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_PASSWORD@db:5432/agroclaw?schema=public

# Gere um segredo aleatório forte. Não reutilize credenciais de outros serviços.
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_JWT_SECRET
JWT_EXPIRES_IN=1d

# Usados para criar/atualizar o administrador ao executar o seed manualmente.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Opcional. Sem chave, a integração de IA permanece indisponível.
GROQ_API_KEY=
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
